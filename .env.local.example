NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- "שכחתי סיסמה" (/api/auth/forgot-password) ---
# נמען ההתראה (ברירת מחדל ohad915@gmail.com)
FORGOT_PASSWORD_NOTIFY_TO=ohad915@gmail.com
# שליחת מייל – אחת משתי האפשרויות:
#  א) SMTP (למשל Gmail עם "סיסמת אפליקציה"):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
#  ב) Resend (https://resend.com):
RESEND_API_KEY=
# אימות אימייל+טלפון מול Firestore: תוכן קובץ ה-Service Account (JSON בשורה אחת) – Firebase Console > Project settings > Service accounts
FIREBASE_SERVICE_ACCOUNT=
# (חובה גם לאיפוס סיסמה ע"י מנהל המערכת: /api/admin/reset-password – משתמש באותו FIREBASE_SERVICE_ACCOUNT)
